{
  "name": "html-maker",
  "private": true,
  "version": "0.3.0",
  "description": "팀장님, 본부장님께 하는 보고 자료를 만드는 HTML 발표 빌더",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build -c vite.node.config.ts",
    "start": "node dist-node/serve.mjs",
    "pack": "node scripts/pack.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mcp": "node dist-node/html-maker-mcp.mjs",
    "licenses": "node scripts/licenses.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/hahmlet": "^5.3.0",
    "@fontsource-variable/noto-serif-kr": "^5.3.1",
    "@sun-typeface/suit": "^2.0.5",
    "idb-keyval": "^6.3.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
